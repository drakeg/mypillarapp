# Docker Compose host binding
# Copy this file to .env and adjust as needed.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# Comma-separated Django host allow-list. For LAN access, include the
# machine's LAN IP and/or mDNS hostname in addition to localhost.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,pillar.madmallards.com
