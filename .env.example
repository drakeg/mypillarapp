# Docker Compose host binding
# Copy this file to .env and adjust as needed.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# Real platform root behavior:
# public = normal tenant/public-site routing
# admin  = redirect / to /admin/sites (useful for local review)
MADMALLARD_ROOT_MODE=public

# Development-only LAN admin bypass. Keep false in production.
# When true, platform-admin routes trust only loopback/private client IPs.
MADMALLARD_LOCAL_ADMIN=false

# Admin cookies remain Secure by default for HTTPS production.
# Set false only for trusted local HTTP development.
MADMALLARD_ADMIN_COOKIE_SECURE=true

MADMALLARD_PRIMARY_DOMAIN=pillar.madmallards.com
